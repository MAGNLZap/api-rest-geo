{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions/AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "tail_turns": 8
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 12000
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "python -m pytest *": "allow",
      "python -m ruff *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow"
    }
  },
  "shell": "pwsh"
}

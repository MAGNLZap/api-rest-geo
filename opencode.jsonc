{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/instructions/project-rules.md",
    ".opencode/instructions/geo-conventions.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "python *": "allow",
      "python -m pytest *": "allow",
      "pip install *": "allow",
      "pip install -r *": "allow",
      "git *": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "New-Item *": "allow",
      "mkdir *": "allow",
      "Remove-Item *": "ask",
      "rm *": "ask"
    }
  },
  "shell": "pwsh"
}

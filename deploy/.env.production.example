# Copiar como .env.production en la raíz. No se usa ni modifica el .env actual.
# La BD debe existir y tener los datos y el esquema actuales.
# Dentro de Docker, localhost NO apunta al host ni a otro servidor.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@db.example.internal:5432/geoportal
ENVIRONMENT=production
ALLOWED_ORIGINS=https://consumer.example.org
ALLOW_LOCAL_NETWORK=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
RATE_LIMIT=120/minute
LOG_LEVEL=INFO

# Interpolación de Compose: usar --env-file .env.production.
# https si el proxy de entrada termina TLS; http para la validación local.
PUBLIC_SCHEME=https
# Puerto de loopback del host; el proxy público conserva 80/443 y TLS.
WEB_PORT=18081
# Cambiar en cada entrega; conservar imágenes anteriores para revertir.
IMAGE_TAG=1.0.0

# Revisar conflictos con redes del host, VPN y Docker antes del arranque.
# Si cambia la subred, ajustar también IP web y gateway de confianza.
GEO_SUBNET=172.30.41.0/24
WEB_IPV4=172.30.41.10
GEO_GATEWAY_CIDR=172.30.41.1/32

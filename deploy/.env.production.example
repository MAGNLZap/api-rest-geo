# Copiar como .env.production en la raíz. No se usa ni modifica el .env actual.
# La BD debe existir y tener los datos y el esquema actuales.
# Dentro de Docker, localhost NO apunta al host ni a otro servidor.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@db.example.internal:5432/apirestgeo
ENVIRONMENT=production
ALLOWED_ORIGINS=https://consumer.example.org
ALLOW_LOCAL_NETWORK=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
RATE_LIMIT=120/minute
LOG_LEVEL=INFO

# Interpolación de Compose: usar --env-file .env.production.
# https si el proxy de entrada termina TLS; http para la validación local.
PUBLIC_SCHEME=https
WEB_PORT=8080

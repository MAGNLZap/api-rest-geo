server {
    listen ${WEB_LISTEN};
    server_name _;
    root ${WEB_ROOT};
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 10m;

    gzip on;
    gzip_types application/javascript application/json application/geo+json text/css image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /web-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = / {
        try_files /index.html =404;
        expires -1;
    }
    location = /servicios_sociales {
        try_files /index.html =404;
        expires -1;
    }
    location = /unidades_infancia {
        try_files /index.html =404;
        expires -1;
    }
    location = /ua_amenazas {
        try_files /index.html =404;
        expires -1;
    }

    location = /servicios_sociales/ {
        return 302 /servicios_sociales;
    }
    location = /unidades_infancia/ {
        return 302 /unidades_infancia;
    }
    location = /ua_amenazas/ {
        return 302 /ua_amenazas;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Nunca devolver el index.html para errores de la API.
    location / {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_redirect off;
        proxy_read_timeout 120s;
    }
}

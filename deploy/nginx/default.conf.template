server {
    listen ${WEB_LISTEN};
    server_name _;
    root ${WEB_ROOT};
    server_tokens off;
    client_max_body_size 10m;

    gzip on;
    gzip_types application/javascript application/json application/geo+json text/css image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /web-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = ${PUBLIC_PATH} {
        return 302 ${PUBLIC_PATH}/;
    }

    location = ${PUBLIC_PATH}/ {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }
    location = ${PUBLIC_PATH}/unidades_infancia {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }
    location = ${PUBLIC_PATH}/ua_amenazas {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }
    location = ${PUBLIC_PATH}/unidades_infancia/ {
        return 302 ${PUBLIC_PATH}/unidades_infancia;
    }
    location = ${PUBLIC_PATH}/ua_amenazas/ {
        return 302 ${PUBLIC_PATH}/ua_amenazas;
    }

    location ^~ ${PUBLIC_PATH}/assets/ {
        rewrite ^${PUBLIC_PATH}/(.*)$ /$1 break;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Everything else in the API namespace goes to FastAPI, including unknown
    # paths. Never apply an SPA fallback to API requests or intercept its errors.
    location ${PUBLIC_PATH}/ {
        rewrite ^${PUBLIC_PATH}/(.*)$ /$1 break;
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_redirect off;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}

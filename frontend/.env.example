# Solo configuración pública: nunca poner credenciales en variables VITE_*.
# Desarrollo nativo: navegador -> Vite -> API local (sin CORS adicional).
VITE_PUBLIC_BASE=/
VITE_API_BASE=
API_PROXY_TARGET=http://127.0.0.1:8001

# Producción bajo el prefijo actual (se define al compilar):
# VITE_PUBLIC_BASE=/api-geo/
# VITE_API_BASE=/api-geo

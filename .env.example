# Entorno: development | production
ENVIRONMENT=development

# Base de datos (SQLite para dev, PostgreSQL para prod)
DATABASE_URL=sqlite+aiosqlite:///./test.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/apirestgeo

# Orígenes CORS permitidos (separados por coma)
ALLOWED_ORIGINS=

# Permitir acceso desde redes locales (true/false)
ALLOW_LOCAL_NETWORK=true

# Host y puerto del servidor
HOST=0.0.0.0
PORT=8001

# Rate limiting (protección contra sobrecarga)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
RATE_LIMIT=120/minute
# En producción con Redis: RATE_LIMIT_STORAGE=redis://localhost:6379
